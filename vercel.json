{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "web": {
            "root": ".",
            "framework": "vite",
            "rewrites": [
                {
                    "source": "/(.*)",
                    "destination": "/index.html"
                }
            ]
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}
